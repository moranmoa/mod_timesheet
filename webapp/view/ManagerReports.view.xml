<mvc:View
	controllerName="modtimesheet.controller.ManagerReports"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	height="100%">

	<Page id="page" showHeader="false" backgroundDesign="Solid" class="mtPage">
		<content>

			<!-- ================= Title ================= -->
			<VBox class="mtHeader">
				<Title text="דוחות נוכחות באחריות ממונה" level="H1" class="mtHeaderTitle" />
			</VBox>

			<!-- ================= Filter bar ================= -->
			<VBox class="mtFilterBar">
				<FlexBox wrap="Wrap" alignItems="End" class="mtFilterRow">

					<!-- Search (right-most in RTL) -->
					<VBox class="mtFilterField mtFilterFieldWide">
						<Label text="חיפוש דוח לפי שם, מס. עובד או מחלקה" class="mtFilterLabel" />
						<SearchField
							id="searchField"
							placeholder="חיפוש דוח לפי שם, מס. עובד, מחלקה"
							search=".onSearch"
							liveChange=".onSearch"
							width="100%" />
					</VBox>

					<!-- Report type (single select) -->
					<VBox class="mtFilterField">
						<Label text="סוג דוח" class="mtFilterLabel" />
						<Select
							id="reportTypeSelect"
							width="100%"
							selectedKey="ATTENDANCE"
							change=".onFilterChange"
							items="{
								path: 'options>/reportTypes',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</Select>
					</VBox>

					<!-- Year (multi) -->
					<VBox class="mtFilterField">
						<Label text="שנה" class="mtFilterLabel" />
						<MultiComboBox
							id="yearFilter"
							width="100%"
							placeholder="הכל"
							selectionFinish=".onFilterChange"
							items="{
								path: 'options>/years',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</MultiComboBox>
					</VBox>

					<!-- Month (multi) -->
					<VBox class="mtFilterField">
						<Label text="חודש" class="mtFilterLabel" />
						<MultiComboBox
							id="monthFilter"
							width="100%"
							placeholder="הכל"
							selectionFinish=".onFilterChange"
							items="{
								path: 'options>/months',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</MultiComboBox>
					</VBox>

					<!-- Population (multi) -->
					<VBox class="mtFilterField">
						<Label text="אוכלוסייה" class="mtFilterLabel" />
						<MultiComboBox
							id="populationFilter"
							width="100%"
							placeholder="אוכלוסייה"
							selectionFinish=".onFilterChange"
							items="{
								path: 'options>/populations',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</MultiComboBox>
					</VBox>

					<!-- Branch (multi) -->
					<VBox class="mtFilterField">
						<Label text="אנף" class="mtFilterLabel" />
						<MultiComboBox
							id="branchFilter"
							width="100%"
							placeholder="הכל"
							selectionFinish=".onFilterChange"
							items="{
								path: 'options>/branches',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</MultiComboBox>
					</VBox>

					<!-- Unit (multi) -->
					<VBox class="mtFilterField">
						<Label text="יחידה" class="mtFilterLabel" />
						<MultiComboBox
							id="unitFilter"
							width="100%"
							placeholder="הכל"
							selectionFinish=".onFilterChange"
							items="{
								path: 'options>/units',
								templateShareable: false
							}">
							<core:Item key="{options>key}" text="{options>text}" />
						</MultiComboBox>
					</VBox>

				</FlexBox>
				<HBox justifyContent="End" class="mtFilterActions">
					<Button
						text="איפוס פילטרים"
						icon="sap-icon://clear-filter"
						type="Transparent"
						press=".onResetFilters" />
				</HBox>
			</VBox>

			<!-- ================= Status tabs ================= -->
			<IconTabBar
				id="statusTabBar"
				class="mtStatusTabs"
				expandable="false"
				selectedKey="PENDING_MY_APPROVAL"
				select=".onStatusSelect"
				backgroundDesign="Transparent"
				headerBackgroundDesign="Transparent">
				<items>
					<IconTabFilter
						key="PENDING_EMPLOYEE"
						text="ממתין לעובד"
						icon="sap-icon://employee"
						count="{view>/statusCounts/PENDING_EMPLOYEE}" />
					<IconTabFilter
						key="PENDING_MY_APPROVAL"
						text="ממתין לאישורי"
						icon="sap-icon://manager"
						count="{view>/statusCounts/PENDING_MY_APPROVAL}" />
					<IconTabFilter
						key="PENDING_HR"
						text='ממתין למשא"ן'
						icon="sap-icon://group"
						count="{view>/statusCounts/PENDING_HR}" />
					<IconTabFilter
						key="APPROVED"
						text="אושרו"
						icon="sap-icon://complete"
						count="{view>/statusCounts/APPROVED}" />
				</items>
			</IconTabBar>

			<!-- ================= Table ================= -->
			<Table
				id="reportsTable"
				class="mtTable"
				inset="false"
				growing="true"
				growingThreshold="8"
				growingScrollToLoad="false"
				sticky="ColumnHeaders,HeaderToolbar"
				mode="None"
				items="{
					path: 'reports>/items',
					sorter: []
				}">

				<headerToolbar>
					<OverflowToolbar class="mtTableToolbar">
						<Title id="tableTitle" text="{view>/tableTitle}" level="H3" />
						<ToolbarSpacer />
						<!-- legend -->
						<HBox alignItems="Center" class="mtLegend">
							<core:Icon src="sap-icon://record" color="#e9730c" size="0.7rem" class="mtLegendDot" />
							<Text text="שלב ממתין" class="mtLegendText" />
							<core:Icon src="sap-icon://record" color="#36a41d" size="0.7rem" class="mtLegendDot" />
							<Text text="שלב אושר" class="mtLegendText" />
						</HBox>
						<Button
							icon="sap-icon://action-settings"
							type="Transparent"
							text="הגדרות תצוגה"
							tooltip="הגדרות תצוגה"
							press=".onOpenViewSettings" />
						<Button
							icon="sap-icon://excel-attachment"
							type="Transparent"
							text="ייצוא לאקסל"
							tooltip="ייצוא לאקסל"
							press=".onExport" />
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column width="12rem" hAlign="Begin">
						<Text text="שם עובד" />
					</Column>
					<Column width="7rem" hAlign="Begin" minScreenWidth="Tablet" demandPopin="true">
						<Text text="מספר עובד" />
					</Column>
					<Column hAlign="Begin" minScreenWidth="Tablet" demandPopin="true">
						<Text text="אוכלוסייה" />
					</Column>
					<Column hAlign="Begin" minScreenWidth="Desktop" demandPopin="true">
						<Text text="אנף" />
					</Column>
					<Column hAlign="Begin" minScreenWidth="Desktop" demandPopin="true">
						<Text text="יחידה" />
					</Column>
					<Column hAlign="Begin" minScreenWidth="Desktop" demandPopin="true">
						<Text text="שם ממונה" />
					</Column>
					<Column width="8rem" hAlign="Begin" minScreenWidth="Tablet" demandPopin="true">
						<Text text="חודש לאישור" />
					</Column>
					<Column width="9rem" hAlign="Center">
						<Text text="השלמת תהליך" />
					</Column>
					<Column width="3rem" hAlign="Center" />
				</columns>

				<items>
					<ColumnListItem vAlign="Middle" class="mtRow">
						<cells>
							<!-- שם עובד -->
							<Text text="{reports>employeeName}" class="mtEmpName" />

							<!-- מספר עובד -->
							<Text text="{reports>employeeNumber}" />

							<!-- אוכלוסייה chip -->
							<HBox class="mtPopChip" alignItems="Center" justifyContent="Center">
								<core:Icon src="sap-icon://locked" class="mtPopChipIcon" size="0.75rem" />
								<Text text="{reports>population}" class="mtPopChipText" />
							</HBox>

							<!-- אנף -->
							<Text text="{reports>branch}" maxLines="1" />

							<!-- יחידה -->
							<Text text="{reports>unit}" maxLines="1" />

							<!-- שם ממונה -->
							<Text text="{reports>managerName}" />

							<!-- חודש לאישור -->
							<HBox alignItems="Center" class="mtMonthCell">
								<Text text="{reports>approvalMonth}" />
								<Text
									text="{path: 'reports>extraMonths', formatter: '.formatter.extraMonthsText'}"
									visible="{path: 'reports>extraMonths', formatter: '.formatter.extraMonthsVisible'}"
									class="mtMonthBadge" />
							</HBox>

							<!-- השלמת תהליך -->
							<HBox alignItems="Center" justifyContent="Center" class="mtProgressCell">
								<Text
									text="{parts: ['reports>processStep','reports>processTotal'], formatter: '.formatter.stepText'}"
									class="mtProgressText" />
								<HBox alignItems="Center" class="mtDots" items="{path: 'reports>stepStates', templateShareable: false}">
									<core:Icon
										src="sap-icon://record"
										size="0.65rem"
										class="mtDot"
										color="{path: 'reports>state', formatter: '.formatter.stepColor'}" />
								</HBox>
							</HBox>

							<!-- expand -->
							<Button
								icon="sap-icon://navigation-left-arrow"
								type="Transparent"
								class="mtExpandBtn"
								press=".onOpenReport" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>

		</content>
	</Page>
</mvc:View>
