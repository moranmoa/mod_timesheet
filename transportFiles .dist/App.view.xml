<mvc:View
	controllerName="modtimesheet.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%">

	<!-- ============================================================================
	     The app shell: one header row, then the screens.
	     ============================================================================
	     AppHeader is included here rather than in each screen for two reasons. It is
	     the same bar everywhere, so one instance is one place to change it; and it
	     stays put while a screen scrolls, which it could not do from inside a
	     sap.m.Page's content or a sap.f.DynamicPage's (נתוני כל העובדים has no slot
	     for a custom header at all).

	     A screen added to the router from now on gets the bar without touching this
	     file. The fragment itself is still standalone: see its own header for using
	     it in a view of its own.
	     ========================================================================= -->

	<VBox fitContainer="true" renderType="Bare" class="shShell">
		<core:Fragment fragmentName="modtimesheet.view.AppHeader" type="XML" />
		<App id="app" class="shContent" />
	</VBox>

</mvc:View>
